# 后端服务环境变量配置示例
# 复制此文件为 .env 并修改相应的配置值

# 服务器配置
NODE_ENV=development
PORT=3000
SERVER_IP=0.0.0.0
PREFIX=/static/file
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# 反向代理部署时设为代理跳数（如 1）或受信任子网，否则保持 false；影响 request.ip。
TRUST_PROXY=false
# Swagger 文档开关；生产环境默认关闭，设为 true 可显式开启。
SWAGGER_ENABLED=true

# 数据库配置（应用同时兼容旧变量 DB_* 和 SQL_UESRNAME）
SQL_DATABASE=back_end
SQL_USERNAME=app_user
SQL_PASSWORD=your_password
SQL_HOST=localhost
SQL_PORT=3306
SQL_TIMEZONE=+08:00

# 邮箱配置
EMAIL_HOST=smtp.qq.com
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_USER=your_email@example.com
EMAIL_PASS=your_email_password
EMAIL_EXPIRES=300000
EMAIL_FROM=your_email@example.com
EMAIL_VERIFICATION_COOLDOWN=60

# 第三方授权配置
# OAuth 应用登记的回调地址须与此配置一致；生产环境使用 HTTPS 公网地址。
GITEE_CLIENT_ID=
GITEE_CLIENT_SECRET=
GITEE_CALLBACK_URL=http://localhost:3000/auth/oauth/gitee/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:3000/auth/oauth/github/callback
OAUTH_FRONTEND_URL=http://localhost:5173

# 应用配置
JWT_SECRET=replace_with_a_random_secret_of_at_least_32_characters
# Snowflake节点号（0-1023）；同一数据库的每个后端实例必须配置不同值。
SNOWFLAKE_WORKER_ID=0
# Access Token 固定有效 15 分钟；Refresh Token 固定有效 7 天，无需配置过期时间。
LOG_DIR=logs

# 文件上传配置
# 单文件上限（字节），默认 500 KiB；须与 interceptor 限制一致。
UPLOAD_MAX_SIZE=512000
# 单次请求最多上传文件数。
UPLOAD_MAX_COUNT=5
# 允许的小写扩展名白名单，逗号分隔；留空表示不限制。
UPLOAD_ALLOWED_EXTENSIONS=jpg,jpeg,png,gif

# 阿里云 OSS 文件存储（区域填写控制台地域标识，不要填写完整 Endpoint）
OSS_REGION=oss-cn-guangzhou
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET=your_oss_bucket_name
