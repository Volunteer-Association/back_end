{
  "name": "back-end-frontend",
  "version": "0.0.3",
  "description": "nestjs webserver",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "cross-env NODE_ENV=development vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "cross-env NODE_ENV=development vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build --force",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write src/"
  },
  "author": "chenguihui",
  "keywords": [
    "vue3",
    "three",
    "tensorflowjs"
  ],
  "dependencies": {
    "@tensorflow/tfjs": "^4.22.0",
    "axios": "^1.20.0",
    "cropperjs": "^1.7.0",
    "element-plus": "^2.14.7",
    "pinia": "^4.0.3",
    "three": "^0.186.1",
    "vue": "^3.5.43",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@rushstack/eslint-patch": "^1.16.1",
    "@types/node": "^24.2.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.6.0",
    "@vue/tsconfig": "^0.9.1",
    "cross-env": "^7.0.3",
    "eslint": "^10.12.0",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "npm-run-all2": "^9.0.3",
    "prettier": "^3.9.10",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vue-tsc": "^3.3.13"
  },
  "engines": {
    "node": ">=22.14.0",
    "npm": ">=10.9.2"
  }
}
