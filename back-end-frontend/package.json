{
  "name": "back-end-frontend",
  "version": "0.0.3",
  "description": "nestjs webserver",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "cross-env NODE_ENV=development vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "cross-env NODE_ENV=development vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build --force",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write src/"
  },
  "author": "chenguihui",
  "keywords": [
    "vue3",
    "three",
    "tensorflowjs"
  ],
  "dependencies": {
    "@tensorflow/tfjs": "^4.22.0",
    "axios": "^1.11.0",
    "element-plus": "^2.10.5",
    "pinia": "^3.0.3",
    "three": "^0.179.1",
    "vue": "^3.5.18",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@rushstack/eslint-patch": "^1.12.0",
    "@types/node": "^24.2.0",
    "@types/three": "^0.179.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.6.0",
    "@vue/tsconfig": "^0.7.0",
    "cross-env": "^7.0.3",
    "eslint": "^9.32.0",
    "eslint-plugin-vue": "^10.4.0",
    "globals": "^14.0.0",
    "npm-run-all2": "^8.0.4",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^7.0.6",
    "vue-tsc": "^3.0.5"
  },
  "engines": {
    "node": ">=22.14.0",
    "npm": ">=10.9.2"
  }
}
