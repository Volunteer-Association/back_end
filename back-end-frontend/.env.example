# 前端环境变量配置示例
# 复制此文件为 .env 并修改相应的配置值

# API配置
VITE_API_BASE_URL=/api
VITE_API_PROXY_TARGET=http://localhost:3000
VITE_API_TIMEOUT=10000

# 应用配置
VITE_APP_TITLE=后台管理系统
VITE_APP_VERSION=1.0.0
VITE_APP_DESCRIPTION=基于Vue 3和NestJS的前后端分离后台管理系统

# 功能开关
VITE_ENABLE_DEBUG=true
VITE_ENABLE_MOCK=false
VITE_ENABLE_PWA=false

# 第三方服务配置
VITE_OSS_ENDPOINT=
VITE_OSS_ACCESS_KEY_ID=
VITE_OSS_ACCESS_KEY_SECRET=
VITE_OSS_BUCKET=

# AI服务配置（如果使用TensorFlow.js等）
VITE_AI_MODEL_URL=
VITE_AI_API_KEY=

# 地图服务配置（如果使用）
VITE_MAP_API_KEY=

# 其他配置
VITE_UPLOAD_MAX_SIZE=10485760
VITE_UPLOAD_ALLOWED_TYPES=image/jpeg,image/png,image/gif,application/pdf
